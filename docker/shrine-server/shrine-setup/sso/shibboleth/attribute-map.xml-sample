<Attributes xmlns="urn:mace:shibboleth:2.0:attribute-map" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <!--
            ADJUST_FOR_YOUR_SITE (<Attribute> elements).

            The 'name' attributes need to match exactly what your IdP sends in
            its response to your (successful) AuthnRequest.

            The 'id' values are the names of the resulting HTTP request Headers or Attributes
            (not the same as SAML attributes) that are sent to the Servlet.

            Note that the id "userId" matches the REMOTE_USER setting in shibboleth2.xml. This
            is how REMOTE_USER gets populated and available as a request header in the servlet.
            Therefore there needs to be an attribute mapping from the name of the user-identifying
            attribute returned by your idP to the id "userId".
    -->
    <Attribute name="[idP's name for the user id]" id="userId"/>

</Attributes>
