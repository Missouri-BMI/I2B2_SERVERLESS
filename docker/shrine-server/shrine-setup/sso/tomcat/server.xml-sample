=========================================
MERGE THIS INTO YOUR EXISTING server.xml
=========================================


<?xml version="1.0" encoding="UTF-8"?>
<Server port="8005" shutdown="SHUTDOWN">

  ...

  <Service name="Catalina">

    ============================================================================
    SHRINE2020-1325 Do we want to keep the 8080 config element in server.xml?
    ============================================================================
    ...

    <!-- =========== This should already be in this file, from configuring Shrine === -->
    <Connector
        port="6443"
        protocol="org.apache.coyote.http11.Http11NioProtocol"
        maxThreads="150" SSLEnabled="true" scheme="https" secure="true"
        clientAuth="false" sslProtocol="TLS"
        keystoreFile="[your keystore e.g. /opt/shrine/shrine.keystore]"
        keystorePass="[changeit]"
        keyAlias="[your-certificate-alias, e.g *.domain-name]"
    />
    <!-- ==================================================================== -->

    ...

    <!-- ADJUST_FOR_YOUR_SITE =============================================== -->
    <!-- Define an AJP 1.3 Connector on port 8009 -->
    <Connector protocol="org.apache.coyote.ajp.AjpNio2Protocol"
               packetSize="65536"
               proxyName="[your-hostname]"
               proxyPort="443"
               enableLookups="true"
               address="0.0.0.0"
               port="8009"
               allowedRequestAttributesPattern=".*"
               secretRequired="false"
               redirectPort="6443"
               tomcatAuthentication="false"/>
    <!-- ==================================================================== -->

    ...

  </Service>

  ...

</Server>
