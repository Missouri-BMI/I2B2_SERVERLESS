<?xml version='1.0'?>
<!DOCTYPE>
<component-set>
    <components>
        <component>
            <role>org.apache.maven.lifecycle.Lifecycle</role>
            <role-hint>docker create registry</role-hint>
            <implementation>org.apache.maven.lifecycle.Lifecycle</implementation>
            <configuration>
                <id>create-docker-registry</id>
                <phases>
                    <phase>createRegistry</phase>
                </phases>
            </configuration>
        </component>

        <component>
            <role>org.apache.maven.lifecycle.Lifecycle</role>
            <role-hint>docker start registry</role-hint>
            <implementation>org.apache.maven.lifecycle.Lifecycle</implementation>
            <configuration>
                <id>start-registry</id>
                <phases>
                    <phase>startRegistry</phase>
                </phases>
            </configuration>
        </component>

        <component>
            <role>org.apache.maven.lifecycle.Lifecycle</role>
            <role-hint>docker stop registry</role-hint>
            <implementation>org.apache.maven.lifecycle.Lifecycle</implementation>
            <configuration>
                <id>stop-docker-registry</id>
                <phases>
                    <phase>stopRegistry</phase>
                </phases>
            </configuration>
        </component>

        <component>
            <role>org.apache.maven.lifecycle.Lifecycle</role>
            <role-hint>docker build shrine certs</role-hint>
            <implementation>org.apache.maven.lifecycle.Lifecycle</implementation>
            <configuration>
                <id>build-SHRINE-certs</id>
                <phases>
                    <phase>buildShrineCerts</phase>
                </phases>
            </configuration>
        </component>

        <component>
            <role>org.apache.maven.lifecycle.Lifecycle</role>
            <role-hint>docker build SHRINE MySQL</role-hint>
            <implementation>org.apache.maven.lifecycle.Lifecycle</implementation>
            <configuration>
                <id>build-SHRINE-MySQL</id>
                <phases>
                    <phase>buildShrineMySQL</phase>
                </phases>
            </configuration>
        </component>

        <component>
            <role>org.apache.maven.lifecycle.Lifecycle</role>
            <role-hint>docker build SHRINE i2b2 wildfly</role-hint>
            <implementation>org.apache.maven.lifecycle.Lifecycle</implementation>
            <configuration>
                <id>build-SHRINE-i2b2-wildfly</id>
                <phases>
                    <phase>buildShrineI2b2Wildfly</phase>
                </phases>
            </configuration>
        </component>

        <component>
            <role>org.apache.maven.lifecycle.Lifecycle</role>
            <role-hint>docker build SHRINE node</role-hint>
            <implementation>org.apache.maven.lifecycle.Lifecycle</implementation>
            <configuration>
                <id>build-SHRINE-node</id>
                <phases>
                    <phase>buildShrineNode</phase>
                </phases>
            </configuration>
        </component>

        <component>
            <role>org.apache.maven.lifecycle.Lifecycle</role>
            <role-hint>docker build kafka</role-hint>
            <implementation>org.apache.maven.lifecycle.Lifecycle</implementation>
            <configuration>
                <id>build-kafka</id>
                <phases>
                    <phase>buildKafka</phase>
                </phases>
            </configuration>
        </component>

        <component>
            <role>org.apache.maven.lifecycle.Lifecycle</role>
            <role-hint>docker push SHRINE MySQL image</role-hint>
            <implementation>org.apache.maven.lifecycle.Lifecycle</implementation>
            <configuration>
                <id>push-SHRINE-MYSQL-image</id>
                <phases>
                    <phase>pushShrineMySQL</phase>
                </phases>
            </configuration>
        </component>

        <component>
            <role>org.apache.maven.lifecycle.Lifecycle</role>
            <role-hint>docker push SHRINE Certs image</role-hint>
            <implementation>org.apache.maven.lifecycle.Lifecycle</implementation>
            <configuration>
                <id>push-SHRINE-certs-image </id>
                <phases>
                    <phase>pushShrineCerts</phase>
                </phases>
            </configuration>
        </component>

        <component>
            <role>org.apache.maven.lifecycle.Lifecycle</role>
            <role-hint>docker push SHRINE i2b2 wildfly image</role-hint>
            <implementation>org.apache.maven.lifecycle.Lifecycle</implementation>
            <configuration>
                <id>push-SHRINE-i2b2-wildfly-image</id>
                <phases>
                    <phase>pushShrineI2b2Wildfly</phase>
                </phases>
            </configuration>
        </component>

        <component>
            <role>org.apache.maven.lifecycle.Lifecycle</role>
            <role-hint>docker push SHRINE node image</role-hint>
            <implementation>org.apache.maven.lifecycle.Lifecycle</implementation>
            <configuration>
                <id>push-SHRINE-Node-image</id>
                <phases>
                    <phase>pushShrineNode</phase>
                </phases>
            </configuration>
        </component>

        <component>
            <role>org.apache.maven.lifecycle.Lifecycle</role>
            <role-hint>docker push Kafka image</role-hint>
            <implementation>org.apache.maven.lifecycle.Lifecycle</implementation>
            <configuration>
                <id>push-kafka-image</id>
                <phases>
                    <phase>pushKafka</phase>
                </phases>
            </configuration>
        </component>

        <component>
            <role>org.apache.maven.lifecycle.Lifecycle</role>
            <role-hint>docker build all images</role-hint>
            <implementation>org.apache.maven.lifecycle.Lifecycle</implementation>
            <configuration>
                <id>build-all-images</id>
                <phases>
                    <phase>buildShrineMySQL1</phase>
                    <phase>buildShrineCerts1</phase>
                    <phase>buildShrineI2b2Wildfly1</phase>
<!--                    <phase>buildKafka1</phase>-->
                    <phase>buildShrineNode1</phase>
                    <phase>buildAllImages</phase>
                </phases>
                <default-phases>
                    <buildShrineMySQL1>net.shrine.maven.plugin:shrine-docker-custom-lifecycle-plugin:buildShrineMySQL</buildShrineMySQL1>
                    <buildShrineCerts1>net.shrine.maven.plugin:shrine-docker-custom-lifecycle-plugin:buildShrineCerts</buildShrineCerts1>
                    <buildShrineI2b2Wildfly1>net.shrine.maven.plugin:shrine-docker-custom-lifecycle-plugin:buildShrineI2b2Wildfly</buildShrineI2b2Wildfly1>
                    <buildShrineNode1>net.shrine.maven.plugin:shrine-docker-custom-lifecycle-plugin:buildShrineNode</buildShrineNode1>
                    <buildKafka1>net.shrine.maven.plugin:shrine-docker-custom-lifecycle-plugin:buildKafka</buildKafka1>
                </default-phases>
            </configuration>
        </component>

        <component>
            <role>org.apache.maven.lifecycle.Lifecycle</role>
            <role-hint>docker push all images to docker registery</role-hint>
            <implementation>org.apache.maven.lifecycle.Lifecycle</implementation>
            <configuration>
                <id>push-all-images</id>
                <phases>
                    <phase>pushShrineMySQL1</phase>
                    <phase>pushShrineCerts1</phase>
                    <phase>pushShrineI2b2Wildfly1</phase>
                    <phase>pushShrineNode1</phase>
                    <phase>pushKafka1</phase>
                    <phase>pushAllImages</phase>
                </phases>
                <default-phases>
                    <pushShrineMySQL1>net.shrine.maven.plugin:shrine-docker-custom-lifecycle-plugin:pushShrineMySQL</pushShrineMySQL1>
                    <pushShrineCerts1>net.shrine.maven.plugin:shrine-docker-custom-lifecycle-plugin:pushShrineCerts</pushShrineCerts1>
                    <pushShrineI2b2Wildfly1>net.shrine.maven.plugin:shrine-docker-custom-lifecycle-plugin:pushShrineI2b2Wildfly</pushShrineI2b2Wildfly1>
                    <pushShrineNode1>net.shrine.maven.plugin:shrine-docker-custom-lifecycle-plugin:pushShrineNode</pushShrineNode1>
                    <pushKafka1>net.shrine.maven.plugin:shrine-docker-custom-lifecycle-plugin:pushKafka</pushKafka1>
                </default-phases>
            </configuration>
        </component>

        <component>
            <role>org.apache.maven.lifecycle.Lifecycle</role>
            <role-hint>docker up SHRINE network</role-hint>
            <implementation>org.apache.maven.lifecycle.Lifecycle</implementation>
            <configuration>
                <id>start-SHRINE-Network</id>
                <phases>
                    <phase>startNetwork</phase>
                </phases>
            </configuration>
        </component>

        <component>
            <role>org.apache.maven.lifecycle.Lifecycle</role>
            <role-hint>docker down SHRINE network</role-hint>
            <implementation>org.apache.maven.lifecycle.Lifecycle</implementation>
            <configuration>
                <id>stop-SHRINE-Network</id>
                <phases>
                    <phase>stopNetwork</phase>
                </phases>
            </configuration>
        </component>

        <component>
            <role>org.apache.maven.lifecycle.Lifecycle</role>
            <role-hint>refresh the shrine containers in the network</role-hint>
            <implementation>org.apache.maven.lifecycle.Lifecycle</implementation>
            <configuration>
                <id>refresh-shrine-container</id>
                <phases>
                    <phase>buildShrineNode1</phase>
                    <phase>startNetwork1</phase>
                    <phase>refreshShrineNode</phase>
                </phases>
                <default-phases>
                    <buildShrineNode1>net.shrine.maven.plugin:shrine-docker-custom-lifecycle-plugin:buildShrineNode</buildShrineNode1>
                    <startNetwork1>net.shrine.maven.plugin:shrine-docker-custom-lifecycle-plugin:startNetwork</startNetwork1>
                </default-phases>
            </configuration>
        </component>
    </components>
</component-set>
