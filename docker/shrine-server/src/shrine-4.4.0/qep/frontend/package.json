{
  "name": "2.0-webclient",
  "version": "0.0.1",
  "description": "SHRINE Catalyst Webclient 2.0",
  "main": "index.js",
  "engines": {
    "node": "14.17.3"
  },
  "scripts": {
    "start": "NODE_PATH=./src DEBUG=app nodemon web-server",
    "clean": "rimraf dist | rimraf dev-server/webpapp",
    "lint": "eslint src/**/*.js --ignore-pattern __test__/ --quiet",
    "test:watch": "NODE_PATH=./src node node_modules/jest/bin/jest.js --watch --passWithNoTests",
    "test": "NODE_PATH=./src jest --silent",
    "compile": "NODE_PATH=./src webpack --config webpack.prod.config  -p",
    "build": "NODE_PATH=./src npm run test && npm run compile",
    "build-prod": "NODE_PATH=./src npm ci --only=prod && npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@babel/core": "7.4.0",
    "@babel/plugin-proposal-class-properties": "7.7.4",
    "@babel/plugin-transform-runtime": "7.4.3",
    "@babel/polyfill": "7.8.3",
    "@babel/preset-env": "7.4.2",
    "@babel/preset-react": "7.0.0",
    "@babel/runtime": "7.4.3",
    "@date-io/moment": "1.3.11",
    "@fortawesome/fontawesome-free": "6.4.2",
    "@material-ui/core": "4.8.3",
    "@material-ui/icons": "4.5.1",
    "@material-ui/lab": "4.0.0-alpha.39",
    "@material-ui/pickers": "3.2.6",
    "autoprefixer": "9.5.0",
    "autosuggest-highlight": "3.1.1",
    "babel-jest": "24.7.1",
    "babel-loader": "8.0.5",
    "chart.js": "2.9.3",
    "copy-webpack-plugin": "5.1.1",
    "crypto-js": "4.1.1",
    "css-loader": "2.1.1",
    "deepmerge": "4.2.2",
    "enzyme": "3.9.0",
    "enzyme-adapter-react-16": "1.12.1",
    "enzyme-to-json": "3.3.5",
    "file-loader": "3.0.1",
    "html-loader": "0.5.5",
    "html-webpack-plugin": "3.2.0",
    "isomorphic-fetch": "2.2.1",
    "jest": "24.5.0",
    "jquery": "3.6.0",
    "lodash-uuid": "0.0.3",
    "lodash.range": "3.2.0",
    "lodash.throttle": "4.1.1",
    "moment": "2.24.0",
    "node-gyp": "3.8.0",
    "node-sass": "4.13.1",
    "popper.js": "1.14.7",
    "postcss-loader": "3.0.0",
    "prop-types": "15.7.2",
    "randomcolor": "0.6.2",
    "react": "16.14.0",
    "react-beautiful-dnd": "13.0.0",
    "react-chartjs-2": "2.10.0",
    "react-copy-to-clipboard": "5.0.2",
    "react-dnd": "9.3.2",
    "react-dnd-html5-backend": "9.3.2",
    "react-dnd-test-backend": "9.3.4",
    "react-dnd-test-utils": "9.3.4",
    "react-dom": "16.8.6",
    "react-hot-loader": "4.8.2",
    "react-redux": "7.2.4",
    "react-router": "5.2.0",
    "react-router-dom": "5.2.0",
    "react-shepherd": "2.1.0",
    "react-spring": "8.0.27",
    "react-test-renderer": "16.8.6",
    "react-virtualized": "9.21.2",
    "redux-saga": "1.0.2",
    "rimraf": "2.6.3",
    "sass-loader": "7.1.0",
    "style-loader": "0.23.1",
    "typeface-roboto": "0.0.75",
    "url-loader": "1.1.2",
    "validator": "13.7.0",
    "webpack": "4.46.0",
    "webpack-cli": "3.3.12",
    "webpack-hot-middleware": "2.24.3"
  },
  "jest": {
    "verbose": true,
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "testRegex": "(\\.(test|spec))\\.(ts|tsx|js|jsx)$",
    "rootDir": "src/",
    "testURL": "http://localhost",
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "__mocks__/fileMock.js",
      "\\.(css|scss|less)$": "__mocks__/styleMock.js",
      "^dnd-core$": "dnd-core/dist/cjs",
      "^react-dnd$": "react-dnd/dist/cjs",
      "^react-dnd-html5-backend$": "react-dnd-html5-backend/dist/cjs",
      "^react-dnd-touch-backend$": "react-dnd-touch-backend/dist/cjs",
      "^react-dnd-test-backend$": "react-dnd-test-backend/dist/cjs",
      "^react-dnd-test-utils$": "react-dnd-test-utils/dist/cjs"
    },
    "setupFilesAfterEnv": [
      "./__mocks__/setupTests.js"
    ]
  },
  "devDependencies": {
    "babel-eslint": "9.0.0",
    "body-parser": "1.18.3",
    "chalk": "2.4.2",
    "debug": "4.1.1",
    "eslint": "5.16.0",
    "eslint-config-airbnb": "17.1.0",
    "eslint-config-react-app": "4.0.1",
    "eslint-plugin-flowtype": "2.50.3",
    "eslint-plugin-import": "2.18.0",
    "eslint-plugin-jsx-a11y": "6.2.3",
    "eslint-plugin-react": "7.14.2",
    "eslint-plugin-react-hooks": "1.5.0",
    "express": "4.16.4",
    "morgan": "1.9.1",
    "nodemon": "1.18.10",
    "webpack-dev-middleware": "^3.7.3"
  },
  "nodemonConfig": {
    "watch": [
      "dev-server/routes/",
      "dev-server/index.js"
    ],
    "restartable": "rs",
    "ignore": [
      "node_modules/**/node_modules"
    ],
    "delay": "500",
    "env": {
      "NODE_ENV": "development",
      "PORT": 8080
    }
  }
}
